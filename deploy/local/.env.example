# Secreto compartido por todos los servicios (spec 3.4).
JWT_SECRET=gpi-local-secreto-compartido-2026
# Clave de Google Gemini para ai-service (https://aistudio.google.com/apikey).
AI_PROVIDER_API_KEY=
AI_MODEL=gemini-3.8-flash

# Almacenamiento de imágenes y videos de los OVA (Backblaze B2, compatible con
# S3). Opcional: sin estas variables solo se desactiva la subida de archivos.
# Ver content-service/README.md para crear el bucket y la Application Key.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=
