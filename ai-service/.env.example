PORT=8084
# Postgres in deployment, e.g. postgresql+psycopg://user:pass@localhost:5432/ai
# Local development can use SQLite:
DATABASE_URL=sqlite:///./ai.db
# Must be identical to identity-service (spec 3.4).
JWT_SECRET=cambia-este-secreto-en-produccion
LOG_LEVEL=info
# Google Gemini API key (https://aistudio.google.com/apikey).
AI_PROVIDER_API_KEY=
AI_MODEL=gemini-3.8-flash
# Comma-separated origins allowed by CORS (spec 3.7).
CORS_ORIGINS=*
