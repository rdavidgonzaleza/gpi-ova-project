# URL of the API Gateway. Leave empty in local development: the Vite server
# then routes each /api prefix to its microservice (see vite.config.ts).
VITE_API_BASE_URL=

# Data source per microservice: "remote" calls the real service through the
# gateway; "local" uses the in-browser adapter with the same contract
# (spec section 5). Switch a service to "remote" once it is running.
# The AI service has no local adapter: it is always called remotely.
VITE_SOURCE_IDENTITY=remote
VITE_SOURCE_CONTENT=local
VITE_SOURCE_ACTIVITY=local
VITE_SOURCE_EVALUATION=remote
VITE_SOURCE_TRACKING=local

# Microservice URLs used by the local gateway proxy.
SERVICE_IDENTITY_URL=http://localhost:8081
SERVICE_CONTENT_URL=http://localhost:8082
SERVICE_ACTIVITY_URL=http://localhost:8083
SERVICE_AI_URL=http://localhost:8084
SERVICE_EVALUATION_URL=http://localhost:8085
SERVICE_TRACKING_URL=http://localhost:8086
